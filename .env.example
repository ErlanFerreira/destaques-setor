# String de conexao do Postgres (Neon). Sem isso, usa um arquivo SQLite local (local.db).
DATABASE_URL=

# Senha para acessar a pagina de resultados (/resultados). Escolha algo dificil de adivinhar.
RESULTS_KEY=troque-esta-chave

# Usada para assinar o cookie de acesso aos resultados. Gere com:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-tambem
